{
  "name": "dial-up-telephone",
  "version": "0.2.0",
  "private": true,
  "description": "Dial-Up Telephone: the telephone drawing game, played over an acoustic modem. Every drawing and guess travels between phones as sound.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-ggwave.mjs",
    "predev": "npm run vendor",
    "dev": "vite",
    "predev:https": "npm run vendor",
    "dev:https": "vite --host --mode https",
    "prebuild": "npm run vendor",
    "build": "tsc --noEmit && vite build",
    "check": "npm run build && vitest --run",
    "screens": "vitest --run --config vitest.browser.config.ts",
    "preview": "vite preview --host --mode https",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ggwave": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "fast-check": "^3.23.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
